       IDENTIFICATION DIVISION.
       PROGRAM-ID. COBOL-NUMERIC.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WRK-ARG-COUNT    PIC 9(4) BINARY.
       01  WRK-ARG-OPERATE  PIC X(3).
       01  WRK-ARG-NUMERIC1 PIC X(32).
       01  WRK-ARG-NUMERIC2 PIC X(32).
       01  WRK-NUMERIC1     PIC 9(32).
       01  WRK-NUMERIC2     PIC 9(32).
       01  WRK-RESULT       PIC 9(32).
       01  WRK-REMAINDER    PIC 9(32).

       PROCEDURE DIVISION.
       MAIN-LOGIC.
           ACCEPT WRK-ARG-COUNT FROM ARGUMENT-NUMBER.

           IF WRK-ARG-COUNT < 3
               DISPLAY "USAGE : COBOL-NUMERIC OPERATE NUMERIC1 NUMERIC2"
               DISPLAY "OPERATE = ADD|SUB|MUL|DIV"
           ELSE
               ACCEPT WRK-ARG-OPERATE FROM ARGUMENT-VALUE
               DISPLAY "OPERATE: " WRK-ARG-OPERATE
               ACCEPT WRK-ARG-NUMERIC1 FROM ARGUMENT-VALUE
               COMPUTE WRK-NUMERIC1 = FUNCTION NUMVAL(WRK-ARG-NUMERIC1)
               DISPLAY "NUMERIC1: " WRK-NUMERIC1
               ACCEPT WRK-ARG-NUMERIC2 FROM ARGUMENT-VALUE
               COMPUTE WRK-NUMERIC2 = FUNCTION NUMVAL(WRK-ARG-NUMERIC2)
               DISPLAY "NUMERIC2: " WRK-NUMERIC2

               EVALUATE WRK-ARG-OPERATE
                WHEN "ADD"
                ADD WRK-NUMERIC1 TO WRK-NUMERIC2 GIVING WRK-RESULT
                WHEN "SUB"
                SUBTRACT WRK-NUMERIC2 FROM WRK-NUMERIC1
                GIVING WRK-RESULT
                WHEN "MUL"
                MULTIPLY WRK-NUMERIC1 BY WRK-NUMERIC2 GIVING WRK-RESULT
                WHEN "DIV"
                DIVIDE WRK-NUMERIC2 INTO WRK-NUMERIC1 GIVING WRK-RESULT
                REMAINDER WRK-REMAINDER
                DISPLAY "REMAINDER: " WRK-REMAINDER
               END-EVALUATE
               DISPLAY "RESULT: " WRK-RESULT
           END-IF.

           STOP RUN.
